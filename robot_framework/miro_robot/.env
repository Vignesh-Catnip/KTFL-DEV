# Copy this file to .env (same folder) and fill in.
# One setting per line: KEY=VALUE. Comments only on their own line starting with #.
# A password with spaces or " #" in it: put it in quotes, e.g. SAP_PASSWORD="ab #12"

# ---- PostgreSQL (extractor DB) ----
PG_HOST=10.7.11.22
PG_PORT=5432
PG_DB=miro_invoice
PG_USER=appuser
PG_PASSWORD=appuser123

# ---- SAP ----
# Description of the system in SAP Logon (right-click > Properties > Description)
SAP_CONNECTION=KTFL HANA SANDBOX
# Client number shown on the SAP login screen
SAP_CLIENT=150
SAP_USER=ATC01021
SAP_PASSWORD=October@2026
SAP_LANGUAGE=EN
# "." if SAP shows 1,234,567.89   |   "," if SAP shows 1.234.567,89
SAP_DECIMAL_SEP=.
SAP_DATE_FORMAT=%d.%m.%Y

# ---- MIRO ----
MIRO_COMPANY_CODE=2000
# CHECK (nothing saved)  ->  PARK  ->  POST
MIRO_MODE=CHECK
MIRO_SOURCE_STATUS=MATCHED
# allowed difference: selected GRN rows value vs invoice taxable value (INR)
MIRO_AMOUNT_TOLERANCE=1.00
MIRO_BALANCE_TOLERANCE=0.00
MIRO_MAX_ATTEMPTS=3
MIRO_COLLAPSE_HEADER=true
# header tax code: false = tax codes come from the PO items (as in the SAP recording)
MIRO_ENTER_TAX_CODE=false
MIRO_CALCULATE_TAX=true
# Business Place + Section = invoices.plant_code
MIRO_ENTER_PLANT=true
# Text = first invoice line item
MIRO_ENTER_ITEM_TEXT=true
# balance after Amount: up to this value goes to Details > Unpl. Del. Csts, more -> REVIEW
MIRO_MAX_UNPLANNED_COST=1000.00
# Details > Doc. Type per plant code:  plant=key,plant=key   (key = SAP doc type code, e.g. RE)
MIRO_DOC_TYPE_BY_PLANT=
# Doc. Type for plants not in the list (empty = keep SAP default "Invoice - Gross")
MIRO_DOC_TYPE_DEFAULT=
# press Simulate before park / post / exit
MIRO_SIMULATE=true
# slow "watch" mode: seconds per step + red frame on the field (0 = full speed)
MIRO_STEP_DELAY=1.5

# Field names - change only if your MIRO screen differs
MIRO_COL_REF_DOC=DRSEG-LFBNR
MIRO_COL_AMOUNT=DRSEG-WRBTR
MIRO_BALANCE_FIELD=RM08M-DIFFERENZ
MIRO_PARK_MENU=Invoice document>Park
MIRO_ENTER_TAX_CODE=true
