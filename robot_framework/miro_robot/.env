# Copy to .env (same folder) and fill in. Real environment variables override this file.
# ---- PostgreSQL (extractor DB) ----
PG_HOST=10.7.11.22
PG_PORT=5432
PG_DB=miro_invoice
PG_USER=appuser
PG_PASSWORD=appuser123

# ---- SAP ----
SAP_CONNECTION=KTFL HANA SANDBOX          # exact name of the system in SAP Logon pad
SAP_CLIENT=150
SAP_USER=ATC01021
SAP_PASSWORD=October@2026
SAP_LANGUAGE=EN
SAP_DECIMAL_SEP=.                # "." if SU3 shows 1,234,567.89   |   "," if 1.234.567,89
SAP_DATE_FORMAT=%d.%m.%Y

# ---- MIRO ----
MIRO_COMPANY_CODE=2000
MIRO_MODE=CHECK                  # CHECK (nothing saved) -> PARK -> POST
MIRO_SOURCE_STATUS=MATCHED
MIRO_AMOUNT_TOLERANCE=1.00       # GRN rows value vs invoice taxable value (INR)
MIRO_BALANCE_TOLERANCE=0.00
MIRO_MAX_ATTEMPTS=3
MIRO_COLLAPSE_HEADER=true
MIRO_ENTER_AMOUNT=true
MIRO_ENTER_TAX_CODE=true
# Field names - change only if your MIRO layout differs
MIRO_COL_REF_DOC=DRSEG-LFBNR
MIRO_COL_AMOUNT=DRSEG-WRBTR
MIRO_BALANCE_FIELD=RM08M-DIFFERENZ
MIRO_PARK_MENU=Invoice document>Park
