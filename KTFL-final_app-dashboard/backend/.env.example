# Copy to ".env" in this folder and fill in. Never commit the real .env.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/clearmatch
JWT_SECRET=CHANGE_ME_TO_24_PLUS_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# SQL Server (read only: EKKO, EKPO, MSEG)
SAP_ENABLED=true
SAP_SERVER=
SAP_DATABASE=BRONZE_DB
SAP_USER=
SAP_PASSWORD=
SAP_DRIVER=ODBC Driver 17 for SQL Server
SAP_CLIENT=150
SAP_HSN_COLUMNS=EKPO.J_1BNBM

# Ollama
OLLAMA_URL=http://localhost:11434
MODEL_VLM=qwen3-vl:32b
VLM_GROUP_PAGES=2
MAX_PAGES=40
AMOUNT_TOLERANCE=0.0001
IMAGE_PREPROCESS=false

# Folders
WATCH_FOLDER=
OUTPUT_FOLDER=
FINISH_FOLDER=
ERROR_FOLDER=

# Robot (start with CHECK; use POST only after you trust the results)
ROBOT_ENABLED=false
ROBOT_DIR=
ROBOT_MODE=CHECK
ROBOT_AUTO_RUN=false
